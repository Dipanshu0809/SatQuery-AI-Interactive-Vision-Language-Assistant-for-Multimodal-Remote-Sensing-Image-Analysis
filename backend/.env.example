# SatQuery AI LIVE configuration — no demo/sample fallbacks are used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Tried in order when the main model is overloaded (503) or out of quota (429). Optional.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash

# NASA FIRMS free MAP_KEY
FIRMS_API_KEY=

# Copernicus Data Space Sentinel Hub OAuth client
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Optional general NASA API key; GIBS/Worldview public imagery does not require one.
NASA_API_KEY=

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DATABASE_URL=sqlite:///./data/satquery.db
MAX_UPLOAD_MB=15
